# 后端服务配置
HOST=0.0.0.0
PORT=8000

# 模型配置
# 默认使用的摘要模型
DEFAULT_MODEL=csebuetnlp/mT5_multilingual_XLSum

# HuggingFace 镜像源（国内用户可设置为 https://hf-mirror.com）
HF_ENDPOINT=https://hf-mirror.com

# 模型缓存目录（HuggingFace 模型下载位置）
HF_HOME=./models_cache

# 是否使用 GPU（auto 自动检测，cpu 强制 CPU，cuda 强制 GPU）
DEVICE=auto

# CORS 允许的前端地址
CORS_ORIGINS=http://localhost:5173

# 文本最大输入长度（token 数）
MAX_INPUT_LENGTH=1024
